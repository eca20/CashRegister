{
  "name": "truefit-cash-register",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "File-based cash register with exact change and configurable policies",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test dist/test/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:transcript",
    "start": "node dist/src/main.js",
    "serve": "node dist/src/serve.js",
    "dev": "vite",
    "test:transcript": "node --test scripts/sanitize-transcript.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
